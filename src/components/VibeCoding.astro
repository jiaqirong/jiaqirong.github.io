---
import { siteConfig } from "../config";

const items = siteConfig.vibeCoding ?? [];

if (!items.length) {
  return null;
}
---

<section id="vibe-coding" class="scroll-mt-24">
  <div class="max-w-4xl mx-auto px-6 py-16">
    <h2 class="text-3xl font-bold tracking-tight text-gray-900">Vibe Coding & OpenClaw 实践</h2>
    <p class="mt-3 text-gray-600">
      以“AI 辅助快速产出 + 可落地交付”为导向，沉淀从需求到上线的自动化工作流。
    </p>

    <div class="mt-8 grid gap-6">
      {
        items.map((item) => (
          <article class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm">
            <div class="flex flex-col gap-1">
              <h3 class="text-xl font-semibold text-gray-900">{item.name}</h3>
              {item.dateRange && (
                <div class="text-sm text-gray-500">{item.dateRange}</div>
              )}
            </div>

            {item.description && (
              <p class="mt-3 text-gray-700 leading-relaxed">{item.description}</p>
            )}

            {item.bullets?.length ? (
              <ul class="mt-4 list-disc pl-5 space-y-2 text-gray-700">
                {item.bullets.map((b) => (
                  <li>{b}</li>
                ))}
              </ul>
            ) : null}

            {item.links?.length ? (
              <div class="mt-4 flex flex-wrap gap-3">
                {item.links.map((l) => (
                  <a
                    href={l.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-sm font-medium text-teal-700 hover:text-teal-900 underline underline-offset-4"
                  >
                    {l.label}
                  </a>
                ))}
              </div>
            ) : null}
          </article>
        ))
      }
    </div>
  </div>
</section>
