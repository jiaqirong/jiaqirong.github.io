---
import { siteConfig } from "../config";

const papers = siteConfig.papers ?? [];
const patents = siteConfig.patents ?? [];
const hasContent = papers.length > 0 || patents.length > 0;
---

{
  hasContent && (
    <section id="papers-patents" class="p-8 sm:p-12 md:p-16 lg:p-24">
      <div>
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">
          <div class="lg:col-span-4">
            <h2 class="text-3xl sm:text-4xl md:text-5xl xl:text-7xl font-bold text-gray-900">
              论文与专利
            </h2>
            <div
              class="w-[75px] h-[5px] mt-2 rounded-full"
              style={`background-color: ${siteConfig.accentColor}`}
            />
          </div>

          <div class="lg:col-span-8">
            <div class="space-y-10">
              {papers.length > 0 && (
                <div>
                  <h3 class="text-xl sm:text-2xl font-bold text-gray-900">论文</h3>
                  <div class="mt-4 space-y-6">
                    {papers.map((p, index) => (
                      <div class="group relative">
                        <div class="block relative p-4 sm:p-6 md:p-8 bg-gray-50 rounded-xl sm:rounded-2xl border border-gray-200 transition-all duration-300">
                          <div class="space-y-3">
                            <div>
                              <span
                                class="text-sm font-mono"
                                style={{ color: siteConfig.accentColor }}
                              >
                                P0{index + 1}
                              </span>
                              <h4 class="text-lg sm:text-xl font-bold text-gray-900 mt-1">
                                {p.title}
                              </h4>
                            </div>

                            <div class="text-sm sm:text-base text-gray-600">
                              <div><span class="font-medium text-gray-700">发布渠道：</span>{p.venue}</div>
                              {p.authorship && (
                                <div class="mt-1"><span class="font-medium text-gray-700">作者顺序：</span>{p.authorship}</div>
                              )}
                            </div>

                            {p.link && (
                              <div class="pt-2">
                                <a
                                  href={p.link}
                                  target="_blank"
                                  rel="noopener noreferrer"
                                  class="px-2.5 sm:px-3 py-1 sm:py-1.5 bg-gray-900 text-white rounded-md sm:rounded-lg text-xs sm:text-sm font-medium transition-all duration-300 hover:bg-gray-800"
                                >
                                  论文链接
                                </a>
                              </div>
                            )}
                          </div>
                        </div>
                      </div>
                    ))}
                  </div>
                </div>
              )}

              {patents.length > 0 && (
                <div>
                  <h3 class="text-xl sm:text-2xl font-bold text-gray-900">专利</h3>
                  <div class="mt-4 space-y-6">
                    {patents.map((pt, index) => (
                      <div class="group relative">
                        <div class="block relative p-4 sm:p-6 md:p-8 bg-gray-50 rounded-xl sm:rounded-2xl border border-gray-200 transition-all duration-300">
                          <div class="space-y-3">
                            <div>
                              <span
                                class="text-sm font-mono"
                                style={{ color: siteConfig.accentColor }}
                              >
                                Z0{index + 1}
                              </span>
                              <h4 class="text-lg sm:text-xl font-bold text-gray-900 mt-1">
                                {pt.title}
                              </h4>
                            </div>

                            {pt.pubNo && (
                              <div class="text-sm sm:text-base text-gray-600">
                                <span class="font-medium text-gray-700">公开号：</span>{pt.pubNo}
                              </div>
                            )}

                            {pt.abstract && (
                              <p class="text-base sm:text-lg text-gray-600 leading-relaxed">
                                {pt.abstract}
                              </p>
                            )}

                            {pt.link && (
                              <div class="pt-2">
                                <a
                                  href={pt.link}
                                  target="_blank"
                                  rel="noopener noreferrer"
                                  class="px-2.5 sm:px-3 py-1 sm:py-1.5 bg-gray-900 text-white rounded-md sm:rounded-lg text-xs sm:text-sm font-medium transition-all duration-300 hover:bg-gray-800"
                                >
                                  专利链接
                                </a>
                              </div>
                            )}
                          </div>
                        </div>
                      </div>
                    ))}
                  </div>
                </div>
              )}
            </div>
          </div>
        </div>
      </div>
    </section>
  )
}
